{
  "scripts": {
    "backend": "uv run server.py",
    "frontend": "cd langmanus-web && npm run dev",
    "generate-terraform": "npm run terraform-create && npm run terraform-init && npm run terraform-plan && npm run terraform-apply",
    "terraform-create": "python -m terraform_generator.src.main --report report.json --output-dir terraform_output",
    "terraform-init": "cd terraform_output && terraform init",
    "terraform-plan": "cd terraform_output && terraform plan",
    "terraform-apply": "cd terraform_output && terraform apply -auto-approve"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "axios": "^1.9.0",
    "react-big-calendar": "^1.18.0",
    "react-router-dom": "^7.6.0",
    "react-scripts": "^5.0.1"
  }
}
